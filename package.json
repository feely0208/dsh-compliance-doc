{
  "name": "@deepwhale-cn/dsh-compliance-doc",
  "version": "0.2.0",
  "description": "一份能交出去的自查表、整改说明和合规证明",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "skill",
    "security",
    "guard",
    "compliance-doc",
    "合规报告",
    "自查表",
    "整改说明",
    "合规证明",
    "等保"
  ],
  "files": [
    "lib",
    "skill",
    "bin",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./api": "./lib/api.js",
    "./discover": "./lib/discover.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-compliance-doc": "bin/cli.mjs"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepwhale-cn/dsh-guard-core": "^0.10.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-compliance-doc.git"
  },
  "homepage": "https://www.deepwhale.org.cn/skills.html",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-compliance-doc/issues"
  },
  "author": "温州深鲸智能科技有限公司 <contact@deepwhale.org.cn>"
}
